load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load(":define_tc956x_modules.bzl", "define_tc956x_modules")
load(":target.bzl", "define_autogvm")

ddk_headers(
    name = "emac_shim_headers",
    hdrs = glob([
        "drivers/emac_shim/*.h",
    ]),
    includes = ["drivers/emac_shim"]
)

ddk_headers(
    name = "emac_ctrl_fe_headers",
    hdrs = glob([
        "drivers/emac_ctrl_fe/*.h",
    ]),
    includes = ["drivers/emac_ctrl_fe"]
)

ddk_headers(
    name = "include_headers",
    hdrs = glob([
        "drivers/include/**/*.h",
    ]),
    includes = ["drivers/include"]
)

ddk_headers(
    name = "qps615_headers",
    hdrs = glob([
        "drivers/qps615/src/*.h",
    ]),
    includes = ["drivers/qps615/src"],
)

define_tc956x_modules("lahaina", "consolidate")
define_tc956x_modules("lahaina", "perf")

define_autogvm()

pkg_files(
    name = "autogvm_consolidate_dist_files",
    srcs = [":autogvm_consolidate"],
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//visibility:private"],
)

pkg_install(
    name = "autogvm_consolidate_dist",
    srcs = [":autogvm_consolidate_dist_files"],
    destdir = "out/target/product/autogvm/dlkm/lib/modules",
)

pkg_files(
    name = "autogvm_perf_dist_files",
    srcs = [":autogvm_perf"],
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//visibility:private"],
)

pkg_install(
    name = "autogvm_perf_dist",
    srcs = [":autogvm_perf_dist_files"],
    destdir = "out/target/product/autogvm/dlkm/lib/modules",
)
