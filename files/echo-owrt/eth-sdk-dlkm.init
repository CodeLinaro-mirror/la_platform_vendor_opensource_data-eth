START=10
STOP=97

start() {
	echo "Starting ioss Instance"
	/etc/initscripts/eth-sdk-dlkm start
}

stop() {
	echo "Stopping ioss Instance"
	/etc/initscripts/eth-sdk-dlkm stop
}
