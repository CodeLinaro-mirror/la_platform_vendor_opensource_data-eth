# eth-qos: CLI for configuring QoS filters via sysfs
#
# Supported syntax:
#   eth-qos add dev <ifname> hid <handle> queue <qno> ch <chno> offload <1|0> ftype <pcp|vlan|l3l4> [params]
#     pcp:     pcpno <0-7>                               (required)
#     vlan:    vlanid <vid>                              (required)
#     l3l4: [sport <1-65535>] [dport <1-65535>]
#           [proto <tcp|udp>] [sip <IPv4>] [dip <IPv4>]
#           [sipv6 <IPv6>] [dipv6 <IPv6>]
#           (at least one match key required)
#
#   eth-qos add dev <ifname> hid <handle> queue <qno> ch <chno> ftype <tx_pcp> [params]
#     tx_pcp:  pcpno <0-7>                               (required)
#
#   Filter delete: eth-qos delete dev <ifname> hid <handle>
#
#   CBS (tx): eth-qos add dev <ifname> hid <handle> config <cbs> idleslope <val> sendslope <val> hicredit <val> locredit <val> queue <qno> ch <chno> TC <id> offload <1|0>
#   CBS (tx) delete: eth-qos del dev <ifname> hid <handle>
#
#   eth-qos show_qos dev <ifname>
#   eth-qos clear dev <ifname>
#
# Sysfs (as provided by eth_qos.c):
#   /sys/class/net/<ifname>/qos/add_params/{pcp,tx_pcp,vlan,l3l4,tx_bw}
#   /sys/class/net/<ifname>/qos/del
#
# Note:
# - Current kernel/user ABI for updated flows is expected to accept handle-based payloads.

set -euo pipefail

PROG=$(basename "$0")

usage() {
  cat <<'EOF'
Usage:
  eth-qos add dev <ifname> hid <handle> queue <qno> ch <chno> offload <1|0> ftype <pcp|vlan|l3l4> [params]
    pcp:     pcpno <0-7>
    vlan:    vlanid <vid>
    l3l4: [sport <1-65535>] [dport <1-65535>]
          [proto <tcp|udp>] [sip <IPv4>] [dip <IPv4>]
          [sipv6 <IPv6>] [dipv6 <IPv6>]

  eth-qos add dev <ifname> hid <handle> queue <qno> ch <chno> ftype tx_pcp pcpno <0-7>

  eth-qos delete dev <ifname> hid <handle>

  CBS (tx): eth-qos add dev <ifname> hid <handle> config <cbs> idleslope <val> sendslope <val> hicredit <val> locredit <val> queue <qno> ch <chno> TC <id> offload <1|0>
  CBS (tx) delete: eth-qos del dev <ifname> hid <handle>

  eth-qos show_qos dev <ifname>
  eth-qos clear dev <ifname>

Examples:
  eth-qos add dev eth0 hid 10 queue 0 ch 0 offload 1 ftype pcp pcpno 5
  eth-qos add dev eth0 hid 11 queue 1 ch 1 ftype tx_pcp pcpno 3
  eth-qos add dev eth0 hid 12 queue 2 ch 2 offload 1 ftype vlan vlanid 100
  eth-qos add dev eth0 hid 13 queue 1 ch 3 offload 0 ftype l3l4 sip 192.168.1.10
  eth-qos delete dev eth0 hid 12
  eth-qos add dev eth0 hid 20 config cbs idleslope 100000 sendslope -900000 hicredit 1234 locredit -5678 queue 0 ch 2 TC 1 offload 1
  eth-qos del dev eth0 hid 20
  eth-qos show_qos dev eth0
  eth-qos clear dev eth0
EOF
}

die() { echo "$PROG: $*" >&2; exit 1; }

req() { # $1=name $2=value
  [[ -n "${2:-}" ]] || die "missing required parameter: $1"
}

check_sysfs() {
  local dev="$1"
  local d="/sys/class/net/$dev/qos"
  [[ -d "$d" ]] || die "QoS sysfs not present for device '$dev' at $d"
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }
is_port() { is_uint "$1" && (( $1 >= 1 && $1 <= 65535 )); }
is_pcp()  { is_uint "$1" && (( $1 >= 0 && $1 <= 7 )); }
is_int() { [[ "$1" =~ ^-?[0-9]+$ ]]; }
is_num() { [[ "$1" =~ ^0[xX][0-9a-fA-F]+$ || "$1" =~ ^[0-9]+$ ]]; }
is_offload() { [[ "$1" == "0" || "$1" == "1" ]]; }

add_cmd() {
  local dev="" hid="" ftype="" qno="" chno="" offload=""
  local pcpno=""
  local vlanid=""
  local sport="" dport="" proto="" sip="" dip="" sipv6="" dipv6=""
  local tcid="" config="" idleslope="" sendslope="" hicredit="" locredit=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      dev)    dev="${2:-}"; shift 2 ;;
      hid)    hid="${2:-}"; shift 2 ;;
      ftype)  ftype="${2:-}"; shift 2 ;;
      queue)  qno="${2:-}"; shift 2 ;;
      ch)     chno="${2:-}"; shift 2 ;;
      offload) offload="${2:-}"; shift 2 ;;
      pcpno)  pcpno="${2:-}"; shift 2 ;;
      vlanid) vlanid="${2:-}"; shift 2 ;;
      sport)  sport="${2:-}"; shift 2 ;;
      dport)  dport="${2:-}"; shift 2 ;;
      proto)  proto="${2:-}"; shift 2 ;;
      sip)    sip="${2:-}"; shift 2 ;;
      dip)    dip="${2:-}"; shift 2 ;;
      sipv6)  sipv6="${2:-}"; shift 2 ;;
      dipv6)  dipv6="${2:-}"; shift 2 ;;
      TC|tc)  tcid="${2:-}"; shift 2 ;;
      config) config="${2:-}"; shift 2 ;;
      idleslope) idleslope="${2:-}"; shift 2 ;;
      sendslope) sendslope="${2:-}"; shift 2 ;;
      hicredit) hicredit="${2:-}"; shift 2 ;;
      locredit) locredit="${2:-}"; shift 2 ;;
      help|-h|--help) usage; exit 0 ;;
      *) die "unknown parameter: $1" ;;
    esac
  done

  req dev "$dev"
  req hid "$hid"
  is_uint "$hid" || die "hid must be an integer"
  check_sysfs "$dev"

  local base="/sys/class/net/$dev/qos"
  local params="$base/add_params"

  if [[ -z "$ftype" && -n "$config" && "$config" == [cC][bB][sS] ]]; then
    req queue "$qno"
    req ch "$chno"
    req offload "$offload"
    is_uint "$qno" || die "queue must be an integer"
    is_uint "$chno" || die "ch must be an integer"
    is_offload "$offload" || die "offload must be 1 or 0"
    req TC "$tcid"
    is_uint "$tcid" || die "TC id must be an integer"
    req idleslope "$idleslope"
    req sendslope "$sendslope"
    req hicredit "$hicredit"
    req locredit "$locredit"
    is_int "$idleslope" || die "idleslope must be integer"
    is_int "$sendslope" || die "sendslope must be integer"
    is_int "$hicredit" || die "hicredit must be integer"
    is_int "$locredit" || die "locredit must be integer"
    local payload="hid $hid TC $tcid offload $offload queue $qno ch $chno config cbs idleslope $idleslope sendslope $sendslope hicredit $hicredit locredit $locredit"
    if ! echo "$payload" > "$params/tx_bw"; then
      die "CBS not supported by kernel (write to $params/tx_bw failed)"
    fi
    echo "configured CBS: dev=$dev $payload"
    return 0
  fi

  case "$ftype" in
    pcp)
      req queue "$qno"
      req ch "$chno"
      req offload "$offload"
      req pcpno "$pcpno"
      is_uint "$qno" || die "queue must be an integer"
      is_uint "$chno" || die "ch must be an integer"
      is_offload "$offload" || die "offload must be 1 or 0"
      is_pcp "$pcpno" || die "pcpno must be 0..7"
      echo "hid $hid queue $qno ch $chno offload $offload pcp_no $pcpno" > "$params/pcp"
      echo "added pcp filter: dev=$dev hid=$hid queue=$qno ch=$chno offload=$offload pcpno=$pcpno"
      ;;
    tx_pcp)
      req queue "$qno"
      req ch "$chno"
      req pcpno "$pcpno"
      is_uint "$qno" || die "queue must be an integer"
      is_uint "$chno" || die "ch must be an integer"
      is_pcp "$pcpno" || die "pcpno must be 0..7"
      echo "hid $hid queue $qno ch $chno pcp_no $pcpno" > "$params/tx_pcp"
      echo "added tx_pcp mapping: dev=$dev hid=$hid queue=$qno ch=$chno pcpno=$pcpno"
      ;;
    vlan)
      req queue "$qno"
      req ch "$chno"
      req offload "$offload"
      req vlanid "$vlanid"
      is_uint "$qno" || die "queue must be an integer"
      is_uint "$chno" || die "ch must be an integer"
      is_offload "$offload" || die "offload must be 1 or 0"
      is_uint "$vlanid" || die "vlanid must be an integer"
      echo "hid $hid queue $qno ch $chno offload $offload vlanid $vlanid" > "$params/vlan"
      echo "added vlan filter: dev=$dev hid=$hid queue=$qno ch=$chno offload=$offload vlanid=$vlanid"
      ;;
    l3l4)
      req queue "$qno"
      req ch "$chno"
      req offload "$offload"
      is_uint "$qno" || die "queue must be an integer"
      is_uint "$chno" || die "ch must be an integer"
      is_offload "$offload" || die "offload must be 1 or 0"
      if [[ -z "$sport" && -z "$dport" && -z "$proto" && -z "$sip" && -z "$dip" && -z "$sipv6" && -z "$dipv6" ]]; then
        die "l3l4 requires at least one of sport/dport/proto/sip/dip/sipv6/dipv6"
      fi
      [[ -z "$sport" || "$(is_port "$sport"; echo $?)" -eq 0 ]] || die "invalid sport"
      [[ -z "$dport" || "$(is_port "$dport"; echo $?)" -eq 0 ]] || die "invalid dport"
      local payload="hid $hid queue $qno ch $chno offload $offload"
      [[ -n "$sport"  ]] && payload+=" sport $sport"
      [[ -n "$dport"  ]] && payload+=" dport $dport"
      [[ -n "$proto"  ]] && payload+=" proto $proto"
      [[ -n "$sip"    ]] && payload+=" sip $sip"
      [[ -n "$dip"    ]] && payload+=" dip $dip"
      [[ -n "$sipv6"  ]] && payload+=" sipv6 $sipv6"
      [[ -n "$dipv6"  ]] && payload+=" dipv6 $dipv6"
      echo "$payload" > "$params/l3l4"
      echo "added l3l4 filter: dev=$dev hid=$hid queue=$qno ch=$chno offload=$offload payload=[$payload]"
      ;;
    *)
      die "unsupported ftype '$ftype' (expected pcp|tx_pcp|vlan|l3l4)"
      ;;
  esac
}

show_qos_cmd() {
  local dev=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      dev) dev="${2:-}"; shift 2 ;;
      help|-h|--help) usage; exit 0 ;;
      *) die "unknown parameter: $1" ;;
    esac
  done

  req dev "$dev"
  check_sysfs "$dev"
  local node="/sys/class/net/$dev/qos/print"
  [[ -f "$node" ]] || die "print sysfs node not present at $node"
  cat "$node"
}

clear_cmd() {
  local dev=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      dev) dev="${2:-}"; shift 2 ;;
      help|-h|--help) usage; exit 0 ;;
      *) die "unknown parameter: $1" ;;
    esac
  done

  req dev "$dev"
  check_sysfs "$dev"
  local base="/sys/class/net/$dev/qos"

  if ! echo "1" > "$base/clear_all"; then
    die "clear not supported by kernel (write to $base/clear_all failed)"
  fi
  echo "cleared all configurations for dev=$dev"
}

delete_cmd() {
  local dev="" hid=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      dev)    dev="${2:-}"; shift 2 ;;
      hid)    hid="${2:-}"; shift 2 ;;
      help|-h|--help) usage; exit 0 ;;
      *) die "unknown parameter: $1" ;;
    esac
  done

  req dev "$dev"
  req hid "$hid"
  is_uint "$hid" || die "hid must be an integer"
  check_sysfs "$dev"
  local base="/sys/class/net/$dev/qos"

  if ! echo "hid $hid" > "$base/del"; then
    die "delete not supported by kernel (write to $base/del failed)"
  fi
  echo "deleted QoS request sent: dev=$dev hid=$hid"
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 1; }
  case "$1" in
    add) shift; add_cmd "$@";;
    delete|del) shift; delete_cmd "$@";;
    clear) shift; clear_cmd "$@";;
    show_qos) shift; show_qos_cmd "$@";;
    help|-h|--help) usage;;
    *) usage; exit 1;;
  esac
}

main "$@"